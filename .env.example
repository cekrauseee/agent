# Local development; Compose overrides the hostname to postgres.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://agent:agent-local@localhost:5432/agent

# Runtime only. Set DATABASE_DRIVER=neon with a real Neon PostgreSQL URL.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=

# Optional Compose host port overrides when defaults are occupied.
APP_PORT=3000
POSTGRES_PORT=5432
