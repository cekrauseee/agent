{
  "name": "agent-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import ./scripts/web-env.mjs ./node_modules/next/dist/bin/next dev",
    "build": "node --import ./scripts/web-env.mjs ./node_modules/next/dist/bin/next build",
    "start": "node --import ./scripts/web-env.mjs ./node_modules/next/dist/bin/next start",
    "typecheck": "node --import ./scripts/web-env.mjs ./node_modules/next/dist/bin/next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write . --ignore-path node_modules/@agent/prettier-config/ignore",
    "format:check": "prettier --check . --ignore-path node_modules/@agent/prettier-config/ignore",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts && pnpm test:frontend",
    "setup": "agent-env",
    "test:frontend": "node --import tsx --test tests/frontend/*.test.ts"
  },
  "dependencies": {
    "@agent/backend": "workspace:*",
    "@base-ui/react": "^1.8.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "@agent/environment": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "zustand": "5.0.15",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@agent/eslint-config": "workspace:*",
    "@agent/typescript-config": "workspace:*",
    "eslint": "^9",
    "@agent/prettier-config": "workspace:*",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "@agent/test-utils": "workspace:*",
    "pg": "8.23.1",
    "@types/pg": "8.23.1"
  },
  "prettier": "@agent/prettier-config"
}
